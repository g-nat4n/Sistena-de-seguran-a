{
  "name": "smartguard-desktop",
  "version": "1.4.0",
  "description": "SmartGuard AI — aplicativo Windows e macOS",
  "main": "src/main.js",
  "author": "SmartGuard",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg --arm64"
  },
  "build": {
    "appId": "local.smartguard.app",
    "productName": "SmartGuard AI",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "splash/**/*",
      "toast/**/*",
      "renderer/**/*",
      "assets/**/*",
      "config.example.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "SmartGuard-AI-Setup.${ext}",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com",
      "extraResources": [
        {
          "from": "../windows/dist/api",
          "to": "api",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "../windows/dist/vision",
          "to": "vision",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "../windows/dist/runtime/jre",
          "to": "runtime/jre",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "../windows",
          "to": "windows",
          "filter": [
            "*.xml",
            "scripts/**/*"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "assets/icon.icns",
      "artifactName": "SmartGuard-AI-Mac.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extraResources": [
        {
          "from": "../macos/dist/api",
          "to": "api",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "../macos/dist/vision",
          "to": "vision",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "../macos/dist/runtime/jre",
          "to": "runtime/jre",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "g-nat4n",
        "repo": "Sistena-de-seguran-a"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmartGuard AI",
      "license": "license.txt",
      "include": "installer.nsh",
      "warningsAsErrors": false
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
