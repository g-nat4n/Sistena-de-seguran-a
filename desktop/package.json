{
  "name": "smartguard-desktop",
  "version": "1.3.0",
  "description": "SmartGuard AI — aplicativo Windows",
  "main": "src/main.js",
  "author": "SmartGuard",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "local.smartguard.app",
    "productName": "SmartGuard AI",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "splash/**/*",
      "toast/**/*",
      "renderer/**/*",
      "assets/**/*",
      "config.example.json"
    ],
    "extraResources": [
      {
        "from": "../windows/dist/api",
        "to": "api",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../windows/dist/vision",
        "to": "vision",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../windows/dist/runtime/jre",
        "to": "runtime/jre",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../windows",
        "to": "windows",
        "filter": [
          "*.xml",
          "scripts/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "SmartGuard-AI-Setup.${ext}",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "g-nat4n",
        "repo": "Sistena-de-seguran-a"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmartGuard AI",
      "license": "license.txt",
      "include": "installer.nsh",
      "warningsAsErrors": false
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
